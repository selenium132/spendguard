# Copy to .env (never commit .env) and export the values, e.g.:  set -a; . ./.env; set +a
# PayPal sandbox app credentials from developer.paypal.com -> Apps & Credentials -> Sandbox.
# Leave both empty to run offline in replay mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: force offline replay even if credentials are set
# PAYPAL_MODE=replay

# Optional real LLM for the agent. Leave empty to use the offline rule-based mock.
ANTHROPIC_API_KEY=
# SPENDGUARD_LLM_MODEL=claude-sonnet-5-5
# SPENDGUARD_PLANNER=mock
# PORT=8765
# Optional: "card" = PayPal public sandbox test card pays on order creation (no buyer login needed)
# PAYPAL_BUYER=card
